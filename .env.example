# Copy to .env and fill in. Never commit .env.
#
# The contact API (server/contact.js) reads these. Its values are NOT bundled into the site,
# because only VITE_-prefixed variables are exposed to the browser.

# SMTP account that sends the mail (for example your mail provider's SMTP login)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Must be an address this SMTP account is allowed to send from
SMTP_FROM=hello@buildnexa.io

# Where enquiries are delivered
CONTACT_TO=hello@buildnexa.io

# Port for the contact API (Vite dev server proxies /api to this)
PORT=8787
